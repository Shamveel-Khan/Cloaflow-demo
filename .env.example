# AI Provider selection: 'anthropic' (default) or 'openai' (or 'openai-compatible')
AI_PROVIDER=anthropic

# Anthropic configuration
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI-compatible provider (OpenAI, DeepSeek, Ollama, Groq, OpenRouter, vLLM, etc.)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Twilio credentials — for real phone call handling & SMS
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Public URL of this deployment (used in Twilio webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo login credentials (defaults to demo@cloaflow.local / demo123 if not set)
DEMO_EMAIL=demo@cloaflow.local
DEMO_PASSWORD=demo123

# Optional: lock the dashboard + data APIs behind a custom token.
# DASHBOARD_TOKEN=change-me

# Optional: HMAC secret for signing outbound webhooks (X-Cloaflow-Signature).
# WEBHOOK_SIGNING_SECRET=change-me-too

# Discord Voice Bot Configuration (for Discord voice receptionist)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord AI Provider: 'openai' (Groq/OpenAI/Ollama) | 'anthropic' (Claude)
# Optional: defaults to AI_PROVIDER (or auto-detected from valid API keys) if omitted.
DISCORD_AI_PROVIDER=openai

# TTS Provider: 'edge' (default, free, Microsoft neural voices via Edge TTS) | 'openai'
# Only set TTS_PROVIDER=openai when you have a real OpenAI TTS API key (NOT a Groq key).
TTS_PROVIDER=edge

# Optional: dedicated TTS key/URL (only needed when TTS_PROVIDER=openai and you want a
# different key/endpoint than OPENAI_API_KEY / OPENAI_BASE_URL).
# OPENAI_TTS_API_KEY=sk-...
# OPENAI_TTS_BASE_URL=https://api.openai.com/v1

# STT Model override — auto-detected from OPENAI_BASE_URL if not set.
# Groq: whisper-large-v3 | OpenAI: whisper-1 | Override: set below
# STT_MODEL=whisper-large-v3
